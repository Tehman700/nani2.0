# ─────────────────────────────────────────────────────────────
# NANI 2.0 — Environment Configuration
# Copy this file to .env and fill in your own values.
# Never commit the actual .env file to Git.
# ─────────────────────────────────────────────────────────────

# MySQL connection string
# Format: mysql+pymysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# Change "root" and "your_password" to match your MySQL setup.
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/nani2

# JWT secret key — used to sign auth tokens.
# Change this to any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-string

# Redis URL — used for live queue WebSocket broadcasting.
# Default port 6379. Leave as-is unless you changed it.
# Install Redis with: winget install Redis.Redis
REDIS_URL=redis://localhost:6379

# Default admin account created automatically on first run.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=qwerty123
